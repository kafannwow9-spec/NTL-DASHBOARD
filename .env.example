SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh4dWZkY2tjYW13aXp2aWJldnJ5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzNTg3MDQsImV4cCI6MjA5NDkzNDcwNH0.qGDsPj5RZUB8iWeyw62ALyj1n5faD6LPHQl8DQt1ibA"

